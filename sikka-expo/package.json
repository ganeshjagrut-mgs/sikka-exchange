{
  "name": "sikka-expo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:web": "expo start --web",
    "start:web:clear": "expo start --web --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:ios": "expo start --clear && echo 'Press i for iOS simulator'",
    "test:web": "expo start --web --clear && echo 'Opening web version with cleared cache'",
    "reset": "rm -rf node_modules && rm -rf .expo && npm install",
    "clean:cache": "expo start --clear",
    "clean:metro": "npx react-native start --reset-cache",
    "clean:all": "rm -rf node_modules .expo /tmp/metro-* && npm install",
    "debug": "expo start --clear --dev-client",
    "prebuild": "expo prebuild --clean",
    "postinstall": "echo 'Dependencies installed. Use npm run start:clear to begin development.'",
    "use:local": "cp .env.local .env && echo '✅ Switched to LOCAL environment (network IP)'",
    "use:dev": "cp .env.development .env && echo '✅ Switched to DEVELOPMENT environment (GCP server)'",
    "use:prod": "cp .env.production .env && echo '✅ Switched to PRODUCTION environment'",
    "env:show": "echo 'Current environment:' && grep EXPO_PUBLIC_ENV .env && grep EXPO_PUBLIC_API_BASE_URL .env",
    "env:update-local-ip": "node scripts/update-local-ip.js",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "cashfree-pg-api-contract": "^2.0.9",
    "expo": "~54.0.30",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "^19.0.16",
    "expo-font": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.21",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "firebase": "^10.14.1",
    "lucide-react": "^0.542.0",
    "lucide-react-native": "^0.542.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-cashfree-pg-sdk": "^2.2.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "^5.9.3"
  },
  "private": true
}
