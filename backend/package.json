{
  "name": "sikka-exchange-backend",
  "version": "1.0.0",
  "description": "Sikka Exchange - Crypto Trading Platform Backend",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:migrate": "node ../scripts/migrate.js",
    "db:seed": "node ../scripts/seed.js",
    "db:flush": "node ../scripts/flush-db.js",
    "firebase:flush": "node ../scripts/flush-firebase.js",
    "flush:all": "npm run db:flush && npm run firebase:flush"
  },
  "keywords": [
    "crypto",
    "exchange",
    "trading",
    "kucoin",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
